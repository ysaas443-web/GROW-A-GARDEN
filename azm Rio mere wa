-- ١. سکەنەرێ فێقییان
local scannerRunning = false
local connection = nil

local function addStatsGui(obj)
    if not scannerRunning then return end
    if not (obj:IsA("Model") or obj:IsA("Part")) then return end
    
    local weightObj = obj:FindFirstChild("Weight") or obj:FindFirstChild("KG") or obj:FindFirstChild("Size")
    local priceObj = obj:FindFirstChild("Price") or obj:FindFirstChild("Value") or obj:FindFirstChild("SellValue")
    
    local rawWeight = nil
    if weightObj and weightObj:IsA("ValueBase") then
        rawWeight = tonumber(weightObj.Value)
    elseif weightObj and weightObj:IsA("BasePart") then
        rawWeight = tonumber(weightObj.Size.X)
    elseif obj:GetAttribute("Weight") or obj:GetAttribute("KG") then
        rawWeight = tonumber(obj:GetAttribute("Weight") or obj:GetAttribute("KG"))
    end
    
    local rawPrice = nil
    if priceObj and priceObj:IsA("ValueBase") then
        rawPrice = tonumber(priceObj.Value)
    elseif priceObj and type(priceObj.Value) == "number" then
        rawPrice = tonumber(priceObj.Value)
    else
        local attrPrice = obj:GetAttribute("Price") or obj:GetAttribute("SellValue") or obj:GetAttribute("Value")
        if attrPrice then
            rawPrice = tonumber(attrPrice)
        end
    end
    
    if rawWeight or rawPrice then
        if not obj:FindFirstChild("FruitStatsGui") then
            local wVal = "N/N"
            if rawWeight then
                wVal = string.format("%.1f", rawWeight) .. " kg"
            end
            
            local pVal = "N/N"
            if rawPrice then
                pVal = tostring(math.floor(rawPrice + 0.5)) .. " Sheckles"
            end
            
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "FruitStatsGui"
            billboard.Size = UDim2.new(0, 130, 0, 55)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true
            
            local textLabel = Instance.new("TextLabel")
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
            textLabel.TextStrokeTransparency = 0
            textLabel.TextSize = 13
            textLabel.Font = Enum.Font.SourceSansBold
            textLabel.Text = obj.Name .. "\n⚖️ " .. wVal .. "\n💰 " .. pVal
            
            textLabel.Parent = billboard
            billboard.Parent = obj
        end
    end
end

local scanBtn = Instance.new("TextButton")
scanBtn.Size = UDim2.new(1, 0, 0, 40)
scanBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
scanBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
