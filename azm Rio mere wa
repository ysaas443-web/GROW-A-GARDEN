-- لۆپا کۆمکرنا فێقیان (بەتەواوی گرێدایی AutoCollectActive بۆ کو دەمێ OFF بوو بوەستێت)
task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            local totalKg = 0
            local maxKg = tonumber(InputBox.Text) or 70
            local itemsToCollect = {}
            
            for _, obj in ipairs(workspace:GetDescendants()) do
                if (obj:IsA("Model") or obj:IsA("Part")) then
                    local nameLower = obj.Name:lower()
                    local isProtected = string.find(nameLower, "seed") or string.find(nameLower, "tree") or string.find(nameLower, "dar")
                    
                    local w = obj:FindFirstChild("Weight") or obj:FindFirstChild("KG") or obj:FindFirstChild("Size")
                    local weightVal = 0
                    if w and w:IsA("ValueBase") then 
                        weightVal = tonumber(w.Value or 0) 
                    elseif w and w:IsA("BasePart") then
                        weightVal = tonumber(w.Size.X)
                    elseif obj:GetAttribute("Weight") or obj:GetAttribute("KG") then
                        weightVal = tonumber(obj:GetAttribute("Weight") or obj:GetAttribute("KG"))
                    end
                    
                    if not isProtected and weightVal > 0 then 
                        totalKg = totalKg + weightVal 
                    end
                    
                    -- کۆمکرن تنێ ئەگەر Auto Collect لەسەر ON بێت و کێش ژ Max KG کێمتر بێت
                    if AutoCollectActive and not isProtected then
                        if weightVal > 0 and weightVal < (maxKg - 0.05) then
                            table.insert(itemsToCollect, obj)
                        end
                    end
                end
            end
            
            KgDisplay.Text = "⚖️ Total KG: " .. string.format("%.1f", totalKg) .. " kg"
            
            -- ئەگەر OFF بوو، چ جار فێقیان نەنێرە بۆ سێرڤەری تەنانەت ئەگەر تێدابن
            if AutoCollectActive and #itemsToCollect > 0 then
                CollectEvent:FireServer(itemsToCollect)
            end
        end)
    end
end)
