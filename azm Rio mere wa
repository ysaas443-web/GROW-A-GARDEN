local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = scanBtn
scanBtn.Parent = ScrollingFrame

scanBtn.MouseButton1Click:Connect(function()
    scannerRunning = not scannerRunning
    if scannerRunning then
        scanBtn.Text = "📊 Scan Fruit Stats: ON"
        scanBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            addStatsGui(obj)
        end
        
        if not connection then
            connection = workspace.DescendantAdded:Connect(function(obj)
                if scannerRunning then
                    task.wait(0.4)
                    addStatsGui(obj)
                end
            end)
        end
    else
        scanBtn.Text = "📊 Scan Fruit Stats: OFF"
        scanBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            local oldGui = obj:FindFirstChild("FruitStatsGui")
            if oldGui then
                oldGui:Destroy()
            end
        end
    end
end)

-- فەنکشن بۆ دروستکرنا دوگمەیێن کڕینێ ب بادینی
local function createBuyButton(text, eventName)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansSemibold
    btn.Text = text .. ": OFF"
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    btn.Parent = ScrollingFrame
    
    local running = false
    btn.MouseButton1Click:Connect(function()
        running = not running
        btn.Text = text .. ": " .. (running and "ON" or "OFF")
        btn.BackgroundColor3 = running and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
        
        if running then
            task.spawn(function()
                while running do
                    pcall(function()
                        ReplicatedStorage.GameEvents.BuyGearStock:FireServer(eventName)
                    end)
                    task.wait(1)
                end
            end)
        end
    end)
end

