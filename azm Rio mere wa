-- زیادکرنا دوگمەیێن Gear
local function addGearBtn(text, eventName)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansSemibold
    btn.Text = text .. ": OFF"
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.Parent = GearFrame
    
    local running = false
    btn.MouseButton1Click:Connect(function()
        running = not running
        btn.Text = text .. ": " .. (running and "ON" or "OFF")
        btn.BackgroundColor3 = running and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
        
        if running then
            task.spawn(function()
                while running do
                    pcall(function()
                        ReplicatedStorage.GameEvents.BuyGearStock:FireServer(eventName)
                    end)
                    task.wait(1)
                end
            end)
        end
    end)
end

